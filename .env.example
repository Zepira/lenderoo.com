# Supabase — same project as the Lenderoo app, read-only via RLS.
# Powers the /roadmap page (release notes). Safe to expose in the browser
# bundle: the anon key only unlocks what RLS explicitly allows (see
# supabase/migrations/043_release_notes_and_public_feedback.sql in the app
# repo). Without these set, /roadmap shows an empty state.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
